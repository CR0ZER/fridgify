# Copier vers .env et remplir. Ce fichier ne doit jamais etre commit.

# Cle API Google Gemini (utilisee uniquement cote serveur, jamais envoyee au navigateur)
GEMINI_API_KEY=

# Secret partage exige par l'API dans le header X-API-Key.
# Generer avec : python3 -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEY=

# Chemin du fichier SQLite. Relatif = relatif au dossier backend/.
DATABASE_PATH=data/fridgify.db

# Origines autorisees pour le CORS, separees par des virgules.
# "*" convient sur un LAN prive ; a restreindre si l'API sort du reseau.
CORS_ORIGINS=*

# Modele Gemini utilise pour le scan de ticket.
GEMINI_MODEL=gemini-3.6-flash

# --- Notifications de peremption (Web Push) ---
# Paire de cles VAPID identifiant ce serveur aupres des services de push.
# Generer une fois avec :  .venv/bin/python -m app.push
# La changer ensuite invalide tous les abonnements existants.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Contact exige par la specification VAPID, transmis au service de push.
# Apple refuse les adresses manifestement invalides : mettez la votre.
VAPID_SUBJECT=mailto:fridgify@localhost

# Alerte pour ce qui perime dans N jours ou moins (les produits deja perimes
# sont toujours signales).
NOTIFICATION_SEUIL_JOURS=1
